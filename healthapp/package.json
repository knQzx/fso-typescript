{
  "name": "calculators",
  "version": "1.0.0",
  "description": "BMI and exercise calculators for Full Stack Open part 9",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "tsc": "tsc",
    "calculateBmi": "tsc && node bmiCalculator.ts",
    "calculateExercises": "tsc && node exerciseCalculator.ts",
